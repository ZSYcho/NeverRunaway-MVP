{
  "name": "neverrunaway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:phone": "bash scripts/phone.sh",
    "gen": "pnpm --filter @neverrunaway/shared gen",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:contracts": "forge test --root contracts",
    "lint": "oxlint",
    "format": "bash scripts/format.sh --write",
    "format:check": "bash scripts/format.sh --check"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "qrcode": "^1.5.4"
  }
}
