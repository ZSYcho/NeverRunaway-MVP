# Copy to .env.local to override. Every value here is public (bundled into the app).

# Chain the app operates on. Defaults: 31337 (anvil) in dev, 1952 (X Layer testnet) in builds.
# VITE_CHAIN_ID=1952

# Reown (WalletConnect) project ID from https://dashboard.reown.com. Without it the WalletConnect
# option is hidden. localhost is always allowed; add deployed domains to the project's allowlist.
# VITE_WALLETCONNECT_PROJECT_ID=
